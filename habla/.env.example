# Copy to habla/.env (gitignored) and fill in. run.sh loads it.
# Without HABLA_LLM_URL, Habla uses a local Ollama model instead (HABLA_MODEL, default gemma4:e4b).

# OpenAI-compatible server (e.g. your local Codex proxy); Habla calls {HABLA_LLM_URL}/chat/completions
HABLA_LLM_URL=http://127.0.0.1:8317/v1
# gpt-6.1-terra (default, first token ~1.5 s) or gpt-6-luna (faster, ~1 s)
HABLA_LLM_MODEL=gpt-6.1-terra
# Sent as "Authorization: Bearer <key>"
HABLA_LLM_KEY=your-proxy-key
# Keep "none" for a fast first token; low/medium/high make replies start 2-4 s later. Empty = don't send it.
HABLA_LLM_REASONING=none
